{
  "name": "storyhop-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist tsconfig.build.tsbuildinfo",
    "build": "nest build",
    "verify": "tsc --noEmit -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "node scripts/start-dev.js",
    "free-port": "node scripts/free-port.js",
    "start:debug": "nest start --debug --watch",
    "prestart:prod": "node scripts/ensure-build.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "release:check": "npm run verify && npm test -- --runInBand && npm run test:e2e -- --runInBand && npm run smoke:migrations",
    "seed:demo-media": "node scripts/seed-demo-story-media.cjs",
    "seed:demo": "ts-node -r tsconfig-paths/register src/scripts/seed-demo-story.ts",
    "import:demo-media": "ts-node -r tsconfig-paths/register src/scripts/import-demo-story-media.ts",
    "backfill:season-titles": "ts-node -r tsconfig-paths/register src/scripts/backfill-season-titles.ts",
    "diagnose:openrouter": "node scripts/diagnose-openrouter.cjs",
    "smoke:pixazo-r2": "node scripts/smoke-pixazo-r2.cjs",
    "smoke:migrations": "node scripts/smoke-migrations.cjs",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "deploy": "npm ci && npm run build && npm run start:prod"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.735.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "argon2": "^0.31.2",
    "axios": "^1.7.9",
    "fluent-ffmpeg": "^2.1.3",
    "moment": "^2.30.1",
    "openai": "^4.77.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^7.2.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.0.0",
    "@nestjs/schematics": "^9.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.13",
    "@types/jest": "28.1.8",
    "@types/node": "^16.18.125",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "28.1.3",
    "kill-port": "^2.0.1",
    "prettier": "^2.3.2",
    "source-map-support": "^0.5.20",
    "supertest": "^6.1.3",
    "ts-jest": "28.0.8",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "4.1.0",
    "typescript": "^4.7.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "testPathIgnorePatterns": [
      "/chats/",
      "/stories/",
      "/strategy-analysis/"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
